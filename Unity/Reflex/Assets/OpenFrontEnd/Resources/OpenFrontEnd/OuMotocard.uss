/* The MOTOCARD pages (OpenShell.Motocard.cs: STATS, ACHIEVEMENTS, RECORDS, TRICK LIBRARY), in the career menu's look (OuCareer.uss / OuCareerKit.cs
   parts: the warm stage with halftone blots, dark glass panels under ORANGE title bars, the legend band, gold focus). Loaded by the screen after
   OuRestyle.uss; every rule starts with .mc- (or overrides one shared class inside a .mc- container), so nothing else is touched.
   Reference size 1920 x 1080 (OuModern.uss: the panel scales by height). */

.mc-page { flex-grow: 1; flex-shrink: 1; min-height: 0; flex-direction: column; }

/* ------------------------------------------------------------------ the top band: the live portrait, the name and number, the card's figures */
.mc-top { flex-direction: row; align-items: center; height: 178px; flex-shrink: 0; margin-bottom: 14px; }
.ou-frontend.mxa-root .mc-top .ou-portrait { width: 134px; height: 166px; margin-right: 28px; }
.mc-id { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.mc-eyebrow { font-size: 24px; letter-spacing: 6px; color: var(--oc-orange-hot); margin-bottom: -2px; -unity-font-definition: url("Fonts/BarlowCondensed-SemiBold.ttf"); -unity-font-style: normal; }
.mc-name-row { flex-direction: row; align-items: flex-end; }
.mc-number { font-size: 66px; color: var(--oc-orange-hot); margin: 0 18px 0 0; text-shadow: 3px 3px 0 rgba(0, 0, 0, 0.7); -unity-font-definition: url("Fonts/BarlowCondensed-ExtraBoldItalic.ttf"); -unity-font-style: normal; }
.mc-name { font-size: 78px; color: var(--oc-paper); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex-shrink: 1; min-width: 0; text-shadow: 3px 3px 0 rgba(0, 0, 0, 0.7); -unity-font-definition: url("Fonts/BarlowCondensed-ExtraBoldItalic.ttf"); -unity-font-style: normal; }
.mc-note { font-size: 22px; letter-spacing: 3px; color: var(--oc-dim); margin-top: -2px; -unity-font-definition: url("Fonts/BarlowCondensed-SemiBold.ttf"); -unity-font-style: normal; }
.mc-figures { flex-direction: row; flex-shrink: 0; align-items: center; }
.mc-figures .oc-stat { margin-right: 0; margin-left: 12px; min-width: 190px; }
.mc-figures .oc-stat-value { font-size: 54px; }

/* ------------------------------------------------------------------ the tabs */
.ou-frontend.mxa-root .mc-tabs { width: 1120px; height: 64px; margin: 0 0 16px 0; flex-shrink: 0; }
.ou-frontend.mxa-root .mc-tabs .ou-gtab { margin-right: 4px; }
.ou-frontend.mxa-root .mc-tabs .ou-gtab > .mxa-button-label { font-size: 30px; }

.mc-body { flex-grow: 1; flex-shrink: 1; min-height: 0; flex-direction: row; }
.mc-col { flex-direction: column; min-height: 0; margin-right: 24px; }
.mc-col-last { margin-right: 0; }
.mc-fill { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.mc-panel { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.mc-panel > .oc-panel-body { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.mc-panel > .oc-panel-bar { height: 52px; }
.mc-panel > .oc-panel-bar > .oc-panel-title { font-size: 36px; letter-spacing: 3px; }
.mc-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.mc-scroll > .unity-scroll-view__content-viewport { padding: 0 8px 4px 0; }
.mc-empty { font-size: 30px; letter-spacing: 1px; color: var(--oc-dim); white-space: normal; padding: 20px 4px; -unity-font-definition: url("Fonts/BarlowCondensed-SemiBold.ttf"); -unity-font-style: normal; }

/* ------------------------------------------------------------------ STATS */
.mc-stats-a { width: 540px; flex-shrink: 0; }
.mc-stats-b { width: 600px; flex-shrink: 0; }
.mc-stats-c { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.mc-pct { flex-direction: row; align-items: flex-end; height: 150px; margin-top: -8px; }
.mc-pct-num { font-size: 168px; color: var(--oc-paper); margin: -34px 0 0 0; text-shadow: 4px 4px 0 rgba(0, 0, 0, 0.7); -unity-font-definition: url("Fonts/BarlowCondensed-ExtraBoldItalic.ttf"); -unity-font-style: normal; }
.mc-pct-suffix { font-size: 70px; color: var(--oc-orange-hot); margin: 0 0 14px 8px; -unity-font-definition: url("Fonts/BarlowCondensed-ExtraBoldItalic.ttf"); -unity-font-style: normal; }
.mc-bar { height: 22px; background-color: rgba(0, 0, 0, 0.55); border-width: 2px; border-color: var(--oc-line); margin: 4px 0 12px 0; flex-shrink: 0; }
.mc-bar-fill { height: 100%; background-color: var(--oc-orange); }
.mc-bar-gold > .mc-bar-fill { background-color: var(--oc-gold); }
.mc-caption { font-size: 22px; letter-spacing: 1px; color: var(--oc-dim); white-space: normal; margin-bottom: 10px; -unity-font-definition: url("Fonts/BarlowCondensed-SemiBold.ttf"); -unity-font-style: normal; }
.mc-medals { flex-direction: row; margin-top: 8px; flex-shrink: 0; }
.mc-medal { flex-grow: 1; flex-basis: 0; flex-direction: row; align-items: center; padding: 8px 10px 8px 12px; margin-right: 8px; background-color: var(--oc-glass-hi); border-left-width: 6px; }
.mc-medal-gold { border-left-color: rgb(255, 215, 0); }
.mc-medal-silver { border-left-color: rgb(192, 192, 192); }
.mc-medal-bronze { border-left-color: rgb(214, 140, 78); margin-right: 0; }
.mc-medal-cup { width: 46px; height: 46px; margin-right: 8px; -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; }
.mc-medal-num { font-size: 50px; color: var(--oc-paper); -unity-font-definition: url("Fonts/BarlowCondensed-ExtraBoldItalic.ttf"); -unity-font-style: normal; }
.mc-edit { margin-top: 16px; flex-shrink: 0; }
.mc-edit .oc-btn { height: 66px; margin-bottom: 8px; }
.mc-edit .oc-btn-label { font-size: 40px; }

.mc-recent { flex-direction: row; align-items: center; height: 68px; margin: 0 0 6px 0; padding: 0 14px 0 8px; background-color: rgba(255, 255, 255, 0.045); transition-property: background-color, translate; transition-duration: 0.14s; transition-timing-function: ease-out-cubic; }
.mc-recent:hover { background-color: rgba(255, 255, 255, 0.10); }
.mc-recent:focus { background-color: var(--oc-gold); translate: 8px 0; }
.mc-recent-icon { width: 52px; height: 52px; margin-right: 14px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.mc-recent-title { flex-grow: 1; flex-shrink: 1; min-width: 0; font-size: 32px; color: var(--oc-paper); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: -3px; -unity-font-definition: url("Fonts/BarlowCondensed-Bold.ttf"); -unity-font-style: normal; }
.mc-recent-tag { margin-left: 10px; flex-shrink: 0; }
.mc-recent:focus > .mc-recent-title { color: var(--oc-ink); }
.mc-recent:focus > .mc-recent-tag { background-color: rgba(14, 15, 15, 0.82); color: var(--oc-paper); }

.mc-line { flex-direction: row; align-items: center; justify-content: space-between; height: 56px; border-bottom-width: 1px; border-bottom-color: var(--oc-line); flex-shrink: 0; }
.mc-line-label { font-size: 22px; letter-spacing: 4px; color: var(--oc-dim); -unity-font-definition: url("Fonts/BarlowCondensed-SemiBold.ttf"); -unity-font-style: normal; }
.mc-line-value { font-size: 38px; color: var(--oc-paper); -unity-font-definition: url("Fonts/BarlowCondensed-Bold.ttf"); -unity-font-style: normal; }
.mc-line-gold > .mc-line-value { color: var(--oc-gold); }
.mc-extra { font-size: 18px; letter-spacing: 3px; color: var(--oc-dim); margin-top: 12px; white-space: normal; -unity-font-definition: url("Fonts/BarlowCondensed-SemiBold.ttf"); -unity-font-style: normal; }

/* ------------------------------------------------------------------ ACHIEVEMENTS */
.mc-hl-a { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.mc-hl-b { width: 600px; flex-shrink: 0; }
.mc-hl-head { flex-direction: row; align-items: center; justify-content: space-between; height: 54px; flex-shrink: 0; margin-bottom: 8px; }
.mc-hl-count { font-size: 40px; color: var(--oc-paper); -unity-font-definition: url("Fonts/BarlowCondensed-Bold.ttf"); -unity-font-style: normal; }
.mc-hl-count-label { font-size: 22px; letter-spacing: 5px; color: var(--oc-dim); margin-left: 14px; -unity-font-definition: url("Fonts/BarlowCondensed-SemiBold.ttf"); -unity-font-style: normal; }
.mc-hl-headline { flex-direction: row; align-items: baseline; }
.mc-hl-headbar { width: 360px; margin: 0; }
.mc-hl { flex-direction: row; align-items: center; height: 92px; margin: 0 0 6px 0; padding: 0 18px 0 10px; background-color: var(--oc-glass); transition-property: background-color, translate; transition-duration: 0.14s; transition-timing-function: ease-out-cubic; }
.mc-hl:hover { background-color: var(--oc-glass-hi); }
.mc-hl:focus { background-color: var(--oc-gold); translate: 8px 0; }
.mc-hl-unlocked { border-left-width: 6px; border-left-color: var(--oc-orange); padding-left: 4px; }
.mc-hl-icon { width: 72px; height: 72px; margin-right: 18px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.mc-hl-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.mc-hl-title { font-size: 36px; color: var(--oc-paper); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: -3px; -unity-font-definition: url("Fonts/BarlowCondensed-Bold.ttf"); -unity-font-style: normal; }
.mc-hl-desc { font-size: 24px; letter-spacing: 0.5px; color: var(--oc-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: -3px; -unity-font-definition: url("Fonts/BarlowCondensed-SemiBold.ttf"); -unity-font-style: normal; }
.mc-hl-locked > .mc-hl-copy > .mc-hl-title { color: var(--oc-dim); }
.mc-hl-state { flex-direction: row; align-items: center; flex-shrink: 0; margin-left: 12px; }
.mc-hl-progress { font-size: 32px; color: var(--oc-paper); margin-left: 12px; -unity-font-definition: url("Fonts/BarlowCondensed-Bold.ttf"); -unity-font-style: normal; }
.mc-hl:focus > .mc-hl-copy > .mc-hl-title, .mc-hl:focus > .mc-hl-state > .mc-hl-progress { color: var(--oc-ink); }
.mc-hl:focus > .mc-hl-copy > .mc-hl-desc { color: rgba(14, 15, 15, 0.72); }
.mc-hl:focus > .mc-hl-state > .oc-tag { background-color: rgba(14, 15, 15, 0.82); color: var(--oc-paper); }
.mc-hl-big { width: 220px; height: 220px; align-self: center; margin: 4px 0 14px 0; -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; }
.mc-hl-bigtitle { font-size: 52px; color: var(--oc-paper); white-space: normal; -unity-text-align: upper-center; text-shadow: 3px 3px 0 rgba(0, 0, 0, 0.7); -unity-font-definition: url("Fonts/BarlowCondensed-ExtraBoldItalic.ttf"); -unity-font-style: normal; }
.mc-hl-bigdesc { font-size: 32px; letter-spacing: 0.5px; color: var(--oc-dim); white-space: normal; -unity-text-align: upper-center; margin-top: 8px; -unity-font-definition: url("Fonts/BarlowCondensed-SemiBold.ttf"); -unity-font-style: normal; }
.mc-hl-tags { flex-direction: row; justify-content: center; margin: 8px 0 6px 0; }
.mc-hl-meter { margin-top: 18px; }

/* ------------------------------------------------------------------ RECORDS */
.mc-rec-a { width: 600px; flex-shrink: 0; }
.mc-rec-b { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.mc-rec-a .mxa-row { height: 70px; margin: 0 0 8px 0; flex-shrink: 0; }
.mc-rec-a .mxa-row .mxa-row-label { font-size: 26px; letter-spacing: 4px; }
.mc-rec-a .mxa-row .mxa-value { font-size: 36px; }
.mc-loc { flex-direction: row; align-items: center; height: 70px; margin: 0 0 6px 0; padding: 0 16px 0 18px; background-color: var(--oc-glass); transition-property: background-color, translate; transition-duration: 0.14s; transition-timing-function: ease-out-cubic; }
.mc-loc:hover { background-color: var(--oc-glass-hi); }
.mc-loc:focus { background-color: var(--oc-gold); translate: 8px 0; }
.mc-loc-name { flex-grow: 1; flex-shrink: 1; min-width: 0; font-size: 36px; color: var(--oc-paper); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: -3px; -unity-font-definition: url("Fonts/BarlowCondensed-Bold.ttf"); -unity-font-style: normal; }
.mc-loc-best { font-size: 30px; color: var(--oc-gold); margin-left: 12px; flex-shrink: 0; -unity-font-definition: url("Fonts/BarlowCondensed-Bold.ttf"); -unity-font-style: normal; }
.mc-loc-none > .mc-loc-best { color: var(--oc-dim); }
.mc-loc:focus > .mc-loc-name, .mc-loc:focus > .mc-loc-best { color: var(--oc-ink); }
.mc-rec-top { flex-direction: row; align-items: stretch; flex-shrink: 0; margin-bottom: 14px; }
.mc-poster { width: 360px; height: 202px; flex-shrink: 0; margin-right: 22px; background-color: rgba(0, 0, 0, 0.5); -unity-background-scale-mode: scale-and-crop; border-width: 2px; border-color: var(--oc-line); }
.mc-rec-meta { flex-grow: 1; flex-shrink: 1; min-width: 0; justify-content: center; }
.mc-rec-loc { font-size: 62px; color: var(--oc-paper); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-shadow: 3px 3px 0 rgba(0, 0, 0, 0.7); -unity-font-definition: url("Fonts/BarlowCondensed-ExtraBoldItalic.ttf"); -unity-font-style: normal; }
.mc-rec-sub { font-size: 24px; letter-spacing: 5px; color: var(--oc-orange-hot); -unity-font-definition: url("Fonts/BarlowCondensed-SemiBold.ttf"); -unity-font-style: normal; }
.mc-rec-board .oc-row-time { width: 250px; }
.mc-rec-board .oc-row-status { width: 260px; }
.mc-rec-board .oc-row { height: 62px; }

/* ------------------------------------------------------------------ TRICK LIBRARY */
.mc-tr-a { width: 760px; flex-shrink: 0; }
.mc-tr-b { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.mc-tr-head { margin: 6px 0 10px 0; }
.mc-trick { flex-direction: row; align-items: center; height: 84px; margin: 0 0 6px 0; padding: 0 16px 0 14px; background-color: var(--oc-glass); transition-property: background-color, translate; transition-duration: 0.14s; transition-timing-function: ease-out-cubic; }
.mc-trick:hover { background-color: var(--oc-glass-hi); }
.mc-trick:focus { background-color: var(--oc-gold); translate: 8px 0; }
.mc-trick-img { width: 130px; height: 66px; margin-right: 20px; flex-shrink: 0; }
.mc-trick-name { flex-grow: 1; flex-shrink: 1; min-width: 0; font-size: 36px; color: var(--oc-paper); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: -3px; -unity-font-definition: url("Fonts/BarlowCondensed-Bold.ttf"); -unity-font-style: normal; }
.mc-trick:focus > .mc-trick-name { color: var(--oc-ink); }
.mc-trick-big { width: 100%; height: 150px; flex-shrink: 0; margin-bottom: 4px; }
.mc-trick-detail { flex-direction: row; flex-grow: 1; flex-shrink: 1; min-height: 0; align-items: stretch; }
.mc-trick-preview { width: 560px; height: 420px; flex-shrink: 0; align-self: center; margin-right: 24px; background-color: rgba(0, 0, 0, 0.35); border-width: 2px; border-color: var(--oc-line); }
.mc-trick-preview-off { opacity: 0.35; }
.mc-trick-info { flex-grow: 1; flex-shrink: 1; min-width: 0; justify-content: center; }
.mc-trick-gesture { flex-shrink: 0; }
.mc-trick-note { font-size: 24px; letter-spacing: 3px; color: var(--oc-orange-hot); white-space: normal; -unity-text-align: upper-center; margin-top: 10px; -unity-font-definition: url("Fonts/BarlowCondensed-SemiBold.ttf"); -unity-font-style: normal; }
.mc-trick-hints { flex-direction: row; align-self: center; margin-top: 14px; }
.mc-trick-hints .mxa-hint { margin-left: 0; }
.mc-trick-bigname { font-size: 56px; color: var(--oc-paper); white-space: normal; -unity-text-align: upper-center; text-shadow: 3px 3px 0 rgba(0, 0, 0, 0.7); -unity-font-definition: url("Fonts/BarlowCondensed-ExtraBoldItalic.ttf"); -unity-font-style: normal; }

/* ------------------------------------------------------------------ the garage RIDER tab's motocard header takes the focus and opens this page */
.ou-frontend.mxa-root .ou-gmoto:focus { border-top-color: var(--oc-gold); border-left-color: var(--oc-gold); border-right-color: var(--oc-gold); border-bottom-color: var(--oc-gold); background-color: rgba(26, 38, 41, 0.97); }
.ou-frontend.mxa-root .ou-gmoto:focus .ou-portrait-bar { background-color: var(--oc-gold); }
.ou-frontend.mxa-root .ou-gmoto-open { font-size: 20px; letter-spacing: 4px; color: var(--oc-orange-hot); margin: 6px 0 0 0; padding: 0; -unity-font-definition: url("Fonts/BarlowCondensed-Bold.ttf"); -unity-font-style: normal; }
.ou-frontend.mxa-root .ou-gmoto:focus .ou-gmoto-open { color: var(--oc-gold); }
